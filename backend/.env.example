SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
OPENROUTER_API_KEY=your_openrouter_api_key
HOMLY_USER_ID=your-supabase-user-uuid
# Shared secret for /internal/* endpoints (WhatsApp bot, MCP server). Must match
# the INTERNAL_KEY set in backend/whatsapp/.env and backend/mcp_server/.env.
# Required — /internal/mcp/* endpoints reject all requests if this is unset.
INTERNAL_KEY=choose-a-random-secret
# Postgres connection string — use the SESSION POOLER string from Supabase dashboard →
# Connect, not "Direct connection" (that hostname is IPv6-only, unreachable from most
# networks) and not "Transaction pooler" (drops session state Alembic's locking needs).
# Required for `alembic upgrade head` (see backend/migrations/README.md) and for LangGraph
# conversation memory — the app itself falls back to a stateless graph if this is unset,
# but migrations cannot run without it.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
