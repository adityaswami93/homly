SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
OPENROUTER_API_KEY=your_openrouter_api_key
HOMLY_USER_ID=your-supabase-user-uuid
# Direct Postgres connection string from Supabase dashboard → Settings → Database → Connection string
# Required for LangGraph conversation memory. Falls back to stateless if not set.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
