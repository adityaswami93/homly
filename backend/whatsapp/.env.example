FASTAPI_URL=http://localhost:8000
# Shared secret for the backend's /internal/* endpoints. Required — the bot
# exits at startup without it, and the backend rejects every /internal/*
# request if its own INTERNAL_KEY is unset. Must match backend/.env.
INTERNAL_KEY=choose-a-random-secret
# Identifies this bot process's Baileys session rows in `whatsapp_auth`.
BOT_TENANT_ID=default

# NOTE: SUPABASE_KEY and SUPABASE_URL are deliberately NOT here any more.
# This process used to hold the Supabase service role key — an RLS-bypassing,
# never-expiring, every-table credential — to do three narrow things, all of
# which now go through /internal/* on the backend. Adding a database
# credential back to a process that parses untrusted input from the public
# internet undoes that; add an /internal/* endpoint instead.
