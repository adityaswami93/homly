# Shared across dev and build — put these in .env.local
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_ADMIN_EMAIL=your_admin_email@example.com
NEXT_PUBLIC_SITE_URL=https://homly-six.vercel.app

# NEXT_PUBLIC_API_URL differs between local dev and mobile builds.
# Next.js loads these automatically based on the command run — no manual swapping needed:
#   .env.development.local (used by `npm run dev`)   -> NEXT_PUBLIC_API_URL=http://localhost:8000
#   .env.production.local  (used by `npm run build`, i.e. what ships to the mobile app)
#                                                     -> NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000